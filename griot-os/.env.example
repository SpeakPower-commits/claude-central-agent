# --- Claude ------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Cheap worker model used only to distil exchanges into memory rows.
GRIOT_MEMORY_MODEL=claude-haiku-4-5

# --- Security ----------------------------------------------------------------
# Shared secret required on every request that reads or spends.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED in production - the app refuses to start on Vercel without it.
GRIOT_API_KEY=

# --- Storage -----------------------------------------------------------------
# Local development only. Ignored when DATABASE_URL is set.
GRIOT_DB_PATH=./griot.db

# Production Postgres. REQUIRED on Vercel: the filesystem is read-only there,
# so SQLite cannot persist. On Neon, use the POOLED connection string.
DATABASE_URL=

# --- Tuning (optional) -------------------------------------------------------
# GRIOT_HISTORY_TURNS=12      # conversation turns replayed to the model
# GRIOT_MEMORY_LIMIT=8        # memory rows injected into the system prompt
# GRIOT_MAX_OUTPUT_TOKENS=16000
